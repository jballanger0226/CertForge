#!/usr/bin/env python3
"""certforge-update: update CertForge in place. Run on the host as root (sudo certforge-update).

The web interface can tell you a newer release exists, but it can never install one: replacing the
program takes root on the machine, so only someone who can log in to the container or host can do it.

    sudo certforge-update                  install the newest release
    sudo certforge-update main             install a branch or tag straight from GitHub (an unreleased build)
    sudo certforge-update v1.2.0           ... a tag works too
    sudo certforge-update --check [ref]    say what is available (or where a branch is now), change nothing
    sudo certforge-update --version 1.2.0  install that release (also how you go back)
    sudo certforge-update --file X.tar.gz  install a release tarball you downloaded yourself
    sudo certforge-update --rollback       return to the copy saved by the last update

A release is downloaded with its SHA256SUMS and verified. A branch or tag is the source tarball GitHub builds
for that name: it is installed as an unreleased build (version 0.0.0-<commit>) and there is nothing to verify
it against except GitHub over HTTPS, so it is for testing. Either way the current program and data are saved
to /var/backups/certforge, the service is restarted, the health check must pass, and everything is put back
if the new version does not come up.

Settings for this command (not for the web service) go in /etc/certforge-update.env, one KEY=value per line,
readable by root only:
    CERTFORGE_REF=main              what a plain `certforge-update` installs (default: the newest release)
    GITHUB_TOKEN=...                lets it read a private repository (branches and tags only)
    CERTFORGE_UPDATE_REPO=owner/name
Integrity of a release is the checksum published with it over HTTPS from GitHub; releases are not
separately signed.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

REPO = "jballanger0226/CertForge"
KEEP_BACKUPS = 3
MAX_DOWNLOAD = 100 * 1024 * 1024
ALLOWED_TOP = {"app", "requirements.txt", "deploy", "VERSION", "REVISION"}
_SEMVER = re.compile(r"^v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?$")


ENV_FILE = "/etc/certforge-update.env"
_REF = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$")


class Fail(Exception):
    pass


class NotFound(Fail):
    pass


def valid_ref(ref: str) -> bool:
    return bool(_REF.match(ref or "")) and ".." not in ref and "//" not in ref and not ref.endswith(("/", ".lock", "."))


def load_env_file(path) -> dict:
    """KEY=value lines (comments and blank lines allowed). Never executed, never exported to the service."""
    out = {}
    try:
        text = Path(path).read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip("\"'")
    return out


class _KeepTokenOnGitHub(urllib.request.HTTPRedirectHandler):
    """The token is for api.github.com. GitHub redirects a source download to codeload.github.com;
    drop the token for any host that isn't GitHub's, and never follow a redirect to plain http."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        host = urllib.parse.urlparse(newurl)
        if host.scheme != "https":
            raise urllib.error.HTTPError(newurl, code, "refusing a redirect to a non-https address", headers, fp)
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and not (host.hostname or "").endswith((".github.com", ".githubusercontent.com")) and host.hostname != "github.com":
            new.headers.pop("Authorization", None)
            new.unredirected_hdrs.pop("Authorization", None)
        return new


def say(msg: str = "") -> None:
    print(msg, flush=True)


def parse(v: str):
    m = _SEMVER.match((v or "").strip())
    return (int(m[1]), int(m[2]), int(m[3]), m[4] or "") if m else None


def newer(a: str, b: str) -> bool | None:
    pa, pb = parse(a), parse(b)
    if not pa or not pb:
        return None
    key = lambda p: (p[0], p[1], p[2], p[3] == "", p[3])  # noqa: E731
    return key(pa) > key(pb)


def read_line(path: Path) -> str:
    try:
        return path.read_text().strip().splitlines()[0].strip()
    except (OSError, IndexError):
        return ""


class Updater:
    def __init__(self, prefix="/opt/certforge", data="/var/lib/certforge", backups="/var/backups/certforge",
                 service="certforge", repo=REPO, user="certforge", http=None, run=None, health=None, build_venv=None,
                 is_root=None, now=None, token=""):
        self.token = token
        self.prefix, self.data, self.backups = Path(prefix), Path(data), Path(backups)
        self.service, self.repo, self.user = service, repo, user
        self.http = http or self._http
        self.run = run or self._run
        self.health = health or self._health
        self.build_venv = build_venv or self._build_venv
        self.is_root = (lambda: os.geteuid() == 0) if is_root is None else is_root
        self.now = now or (lambda: datetime.now(timezone.utc))

    # ---- the outside world (replaced in tests) -------------------------------------------------------
    def _http(self, url: str, limit: int = MAX_DOWNLOAD, accept: str = "application/vnd.github+json, application/octet-stream") -> bytes:
        headers = {"User-Agent": "certforge-update", "Accept": accept}
        if self.token and urllib.parse.urlparse(url).hostname == "api.github.com":
            headers["Authorization"] = f"Bearer {self.token}"
        req = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.build_opener(_KeepTokenOnGitHub).open(req, timeout=60) as r:
                data = r.read(limit + 1)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                raise NotFound(f"GitHub says {url} doesn't exist" + ("" if self.token else " (a private repository needs GITHUB_TOKEN)")) from None
            raise Fail(f"GitHub answered {e.code} for {url}") from None
        except OSError as e:
            raise Fail(f"Couldn't reach {url}: {getattr(e, 'reason', None) or e}") from None
        if len(data) > limit:
            raise Fail("The download is larger than expected; refusing it.")
        return data

    @staticmethod
    def _run(cmd: list[str]) -> int:
        return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True).returncode

    @staticmethod
    def _health(timeout: int = 90) -> bool:
        import ssl
        ctx = ssl.create_default_context()
        ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE        # talks to this machine only
        end = time.time() + timeout
        while time.time() < end:
            try:
                with urllib.request.urlopen("https://127.0.0.1/healthz", context=ctx, timeout=4) as r:
                    if r.read() == b"ok":
                        return True
            except OSError:
                pass
            time.sleep(2)
        return False

    def _build_venv(self, venv: Path, requirements: Path) -> None:
        subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
        subprocess.run([str(venv / "bin" / "pip"), "install", "--quiet", "--no-cache-dir", "-r", str(requirements)], check=True)

    # ---- what is installed / what exists ---------------------------------------------------------------
    def installed(self) -> tuple[str, str]:
        return read_line(self.prefix / "VERSION") or "unknown", read_line(self.prefix / "REVISION")[:7]

    @staticmethod
    def label(version: str, revision: str) -> str:
        return f"{version} ({revision})" if revision else version

    def release(self, version: str | None) -> dict:
        path = f"tags/v{version.lstrip('v')}" if version else "latest"
        try:
            data = json.loads(self.http(f"https://api.github.com/repos/{self.repo}/releases/{path}", 1_000_000))
        except NotFound:
            raise Fail((f"There is no release v{version.lstrip('v')} of {self.repo}." if version else
                        f"{self.repo} has no published release yet. To install a branch or tag instead: sudo certforge-update main")) from None
        except ValueError:
            raise Fail("GitHub's answer wasn't understood.") from None
        tag = str(data.get("tag_name", ""))
        if not parse(tag):
            raise Fail(f"The release is called '{tag}', which isn't a version number.")
        assets = {a["name"]: a["browser_download_url"] for a in data.get("assets", []) if "name" in a and "browser_download_url" in a}
        return {"version": tag.lstrip("v"), "tag": tag, "assets": assets}

    def resolve(self, ref: str) -> str:
        """The commit a branch or tag points to now (40 hex characters)."""
        if not valid_ref(ref):
            raise Fail(f"'{ref}' isn't a usable branch or tag name.")
        try:
            sha = self.http(f"https://api.github.com/repos/{self.repo}/commits/{urllib.parse.quote(ref, safe='/')}", 1000,
                            "application/vnd.github.sha").decode("ascii", "replace").strip()
        except NotFound:
            raise Fail(f"{self.repo} has no branch or tag called '{ref}'.") from None
        if not re.fullmatch(r"[0-9a-f]{40}", sha):
            raise Fail("GitHub's answer wasn't a commit id.")
        return sha

    # ---- steps -----------------------------------------------------------------------------------------
    @staticmethod
    def verify(tarball: Path, expected: str) -> None:
        got = hashlib.sha256(tarball.read_bytes()).hexdigest()
        if got != expected.lower():
            raise Fail(f"The checksum doesn't match (expected {expected[:16]}…, got {got[:16]}…). Nothing was changed.")

    @staticmethod
    def unpack(tarball: Path, dest: Path, source: bool = False) -> Path:
        """Extract only plain files and folders, only under the expected names, never outside dest.

        A release holds nothing but the expected items. A GitHub source tarball (source=True) is the whole
        repository inside one folder; only the parts a running system needs are taken, the rest is skipped."""
        dest.mkdir(parents=True)
        try:
            with tarfile.open(tarball, "r:*") as tf:
                members = tf.getmembers()
                wrapper = None                      # one wrapping folder (certforge-1.2.0/) is allowed
                chosen = []
                for m in members:
                    parts = Path(m.name).parts
                    if m.name.startswith("/") or ".." in parts or not parts:
                        raise Fail(f"Unsafe path in the archive: {m.name}")
                    if source:
                        if wrapper not in (None, parts[0]):
                            raise Fail("The archive has an unexpected layout.")
                        wrapper = parts[0]
                        if len(parts) == 1 and not m.isdir():
                            raise Fail("The archive has an unexpected layout.")
                        if len(parts) == 1 or parts[1] not in ALLOWED_TOP:
                            continue
                        if not (m.isfile() or m.isdir()):
                            raise Fail(f"The archive contains something that isn't a plain file or folder: {m.name}")
                        chosen.append(m)
                        continue
                    if not (m.isfile() or m.isdir()):
                        raise Fail(f"The archive contains something that isn't a plain file or folder: {m.name}")
                    if parts[0] in ALLOWED_TOP:
                        w = None
                    elif m.isdir() and len(parts) == 1 or len(parts) > 1 and parts[1] in ALLOWED_TOP:
                        w = parts[0]
                    else:
                        raise Fail(f"Unexpected item in the archive: {m.name}")
                    if w is not None and wrapper not in (None, w):
                        raise Fail("The archive has an unexpected layout.")
                    if w is None and wrapper is not None:
                        raise Fail("The archive has an unexpected layout.")
                    wrapper = w if w is not None else wrapper
                    chosen.append(m)
                root = wrapper
                for m in chosen:
                    m.mode &= 0o755 if m.isdir() else 0o644
                    m.uid = m.gid = 0
                    m.uname = m.gname = ""
                tf.extractall(dest, members=chosen, filter="data") if hasattr(tarfile, "data_filter") else tf.extractall(dest, members=chosen)
        except (tarfile.TarError, EOFError, OSError) as e:
            raise Fail(f"The archive couldn't be unpacked: {e}") from None
        src = dest / root if root else dest
        for need in ("app/server.py", "requirements.txt") + (() if source else ("VERSION",)):
            if not (src / need).is_file():
                raise Fail(f"The archive doesn't look like CertForge (missing {need}).")
        return src

    def _service(self, verb: str) -> None:
        if self.run(["systemctl", verb, self.service]) != 0 and verb != "stop":
            raise Fail(f"systemctl {verb} {self.service} failed.")

    def backup(self, version: str, revision: str) -> Path:
        self.backups.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(self.backups, 0o700)
        stamp = self.now().strftime("%Y%m%dT%H%M%SZ")
        path = self.backups / f"certforge-{stamp}-{version.replace('/', '_')}.tar.gz"
        old = os.umask(0o077)
        try:
            with tarfile.open(path, "w:gz") as tf:
                for name in ("app", "requirements.txt", "VERSION", "REVISION"):
                    if (self.prefix / name).exists():
                        tf.add(self.prefix / name, arcname=f"program/{name}")
                if self.data.exists():
                    tf.add(self.data, arcname="data")
        finally:
            os.umask(old)
        os.chmod(path, 0o600)
        keep = sorted(self.backups.glob("certforge-*.tar.gz"))
        for stale in keep[:-KEEP_BACKUPS]:
            stale.unlink()
        return path

    def _place(self, src: Path) -> None:
        for name in ("app", "requirements.txt", "VERSION", "REVISION"):
            target = self.prefix / name
            if target.is_dir():
                shutil.rmtree(target)
            elif target.exists():
                target.unlink()
            if (src / name).exists():
                if (src / name).is_dir():
                    shutil.copytree(src / name, target)
                else:
                    shutil.copy2(src / name, target)
        for root, dirs, files in os.walk(self.prefix / "app"):
            if "__pycache__" in dirs:
                shutil.rmtree(Path(root) / "__pycache__")
                dirs.remove("__pycache__")

    def _restore(self, backup: Path, with_data: bool) -> None:
        with tempfile.TemporaryDirectory(prefix="certforge-restore-") as t:
            with tarfile.open(backup, "r:gz") as tf:
                tf.extractall(t, filter="data") if hasattr(tarfile, "data_filter") else tf.extractall(t)
            self._place(Path(t) / "program")
            if with_data and (Path(t) / "data").exists():
                for item in list(self.data.iterdir()):
                    shutil.rmtree(item) if item.is_dir() and not item.is_symlink() else item.unlink()
                for item in (Path(t) / "data").iterdir():
                    (shutil.copytree if item.is_dir() else shutil.copy2)(item, self.data / item.name)
                self._chown(self.data)

    def _chown(self, path: Path) -> None:
        try:
            import pwd
            u = pwd.getpwnam(self.user)
        except (ImportError, KeyError):
            return
        for root, dirs, files in os.walk(path):
            for n in [root, *[os.path.join(root, x) for x in dirs + files]]:
                try:
                    os.chown(n, u.pw_uid, u.pw_gid)
                except OSError:
                    pass

    def _record(self, before: str, after: str, backup: Path, source: str = "release") -> None:
        note = {"from_version": before, "to_version": after, "when": self.now().strftime("%Y-%m-%dT%H:%M:%SZ"), "backup": str(backup),
                "source": source}
        tmp = self.data / ".last-update.tmp"
        tmp.write_text(json.dumps(note))
        os.chmod(tmp, 0o600)
        os.replace(tmp, self.data / "last-update.json")
        self._chown(self.data / "last-update.json")

    # ---- commands --------------------------------------------------------------------------------------
    def check(self, version: str | None = None, ref: str | None = None) -> int:
        cur, rev = self.installed()
        say(f"Installed: {self.label(cur, rev)}")
        if ref:
            sha = self.resolve(ref)
            say(f"{ref} is at {sha[:7]} on {self.repo}")
            say("That is the commit you are running." if rev and sha.startswith(rev) else f"That is a different commit; `sudo certforge-update {ref}` would install it.")
            return 0
        rel = self.release(version)
        say(f"Latest:    {rel['version']}")
        n = newer(rel["version"], cur)
        say("You are up to date." if n is False and not version else "An update is available." if n else "These can't be compared; use --version to choose.")
        return 0

    def install(self, version: str | None = None, file: Path | None = None, sha256: str | None = None, yes: bool = True,
                ref: str | None = None, force: bool = False) -> int:
        self._need_root()
        cur, rev = self.installed()
        with tempfile.TemporaryDirectory(prefix="certforge-update-") as t:
            work = Path(t)
            source, sha = "release", ""
            if ref:
                sha = self.resolve(ref)
                source = f"{ref} @ {sha[:7]}"
                if rev and sha.startswith(rev) and not force:
                    say(f"CertForge {self.label(cur, rev)} is already {ref} at {sha[:7]}. Nothing to do (add --force to reinstall it).")
                    return 0
                say(f"Downloading {ref} ({sha[:7]}) from {self.repo} …")
                tarball = work / "source.tar.gz"
                tarball.write_bytes(self.http(f"https://api.github.com/repos/{self.repo}/tarball/{sha}", MAX_DOWNLOAD, "application/vnd.github+json"))
                target = None
            elif file:
                source = "file"
                tarball = Path(file)
                if not tarball.is_file():
                    raise Fail(f"{file} doesn't exist.")
                if not sha256:
                    say("Note: no --sha256 given, so this file is installed unverified. You are trusting wherever you got it.")
                else:
                    self.verify(tarball, sha256)
                target = None
            else:
                rel = self.release(version)
                target = rel["version"]
                if not version and newer(target, cur) is False:
                    say(f"CertForge {self.label(cur, rev)} is already the newest release.")
                    return 0
                name = f"certforge-{target}.tar.gz"
                if name not in rel["assets"] or "SHA256SUMS" not in rel["assets"]:
                    raise Fail(f"Release v{target} has no {name} / SHA256SUMS to install.")
                say(f"Downloading CertForge {target} …")
                tarball = work / name
                tarball.write_bytes(self.http(rel["assets"][name]))
                sums = self.http(rel["assets"]["SHA256SUMS"], 1_000_000).decode("utf-8", "replace")
                want = next((ln.split()[0] for ln in sums.splitlines() if len(ln.split()) == 2 and ln.split()[1].lstrip("*") == name), "")
                if not re.fullmatch(r"[0-9a-fA-F]{64}", want):
                    raise Fail(f"SHA256SUMS has no entry for {name}.")
                self.verify(tarball, want)
                say("Checksum verified.")
            src = self.unpack(tarball, work / "unpacked", source=bool(ref))
            if ref:
                # GitHub names the folder owner-repo-<commit>; it must be the commit we asked for.
                got = src.name.rsplit("-", 1)[-1]
                if len(got) < 7 or not sha.startswith(got):
                    raise Fail("The download isn't the commit that was asked for. Nothing was changed.")
                tag = ref.removeprefix("refs/tags/")
                (src / "VERSION").write_text((tag.lstrip("v") if parse(tag) else f"0.0.0-{sha[:7]}") + "\n")
                (src / "REVISION").write_text(sha + "\n")
                say(f"Note: this is the source of '{ref}', not a release: it isn't checksummed and it may be unfinished.")
            new_version, new_rev = read_line(src / "VERSION"), read_line(src / "REVISION")[:7]
            if target and new_version.lstrip("v") != target:
                raise Fail(f"The archive says it is {new_version}, not {target}. Nothing was changed.")
            say(f"Updating {self.label(cur, rev)}  →  {self.label(new_version, new_rev)}")
            venv_new = None
            if read_line_all(src / "requirements.txt") != read_line_all(self.prefix / "requirements.txt") or not (self.prefix / "venv").exists():
                say("Dependencies changed; building a new Python environment …")
                venv_new = self.prefix / "venv.new"
                shutil.rmtree(venv_new, ignore_errors=True)
                try:
                    self.build_venv(venv_new, src / "requirements.txt")
                except (subprocess.CalledProcessError, OSError) as e:
                    shutil.rmtree(venv_new, ignore_errors=True)
                    raise Fail(f"Couldn't install the new dependencies ({e}). Nothing was changed.") from None
            self._service("stop")
            backup = self.backup(cur, rev)
            say(f"Saved the current program and data to {backup}")
            venv_old = None
            try:
                self._place(src)
                if venv_new:
                    venv_old = self.prefix / "venv.old"
                    shutil.rmtree(venv_old, ignore_errors=True)
                    if (self.prefix / "venv").exists():
                        (self.prefix / "venv").rename(venv_old)
                    venv_new.rename(self.prefix / "venv")
                self._service("start")
                ok = self.health()
            except Exception as e:  # noqa: BLE001
                say(f"The update failed: {e}")
                ok = False
            if not ok:
                say("The new version did not come up. Putting the previous version back …")
                self.run(["systemctl", "stop", self.service])
                self._restore(backup, with_data=True)
                if venv_old and venv_old.exists():
                    shutil.rmtree(self.prefix / "venv", ignore_errors=True)
                    venv_old.rename(self.prefix / "venv")
                self._service("start")
                back = self.health()
                say(f"CertForge {self.label(cur, rev)} is {'running again' if back else 'NOT responding; check: journalctl -u certforge'}.")
                raise Fail("Rolled back." if back else "Rollback finished but the service isn't healthy.")
            if venv_old:
                shutil.rmtree(venv_old, ignore_errors=True)
            self._record(self.label(cur, rev), self.label(new_version, new_rev), backup, source)
            say(f"Done. CertForge {self.label(new_version, new_rev)} is running.")
            say(f"To go back:  sudo certforge-update --rollback   (backup: {backup})")
        return 0

    def rollback(self) -> int:
        self._need_root()
        saved = sorted(self.backups.glob("certforge-*.tar.gz"))
        if not saved:
            raise Fail("There is no saved copy to go back to.")
        backup = saved[-1]
        cur, rev = self.installed()
        say(f"Restoring the program from {backup.name} (your data is left as it is now).")
        self._service("stop")
        self._restore(backup, with_data=False)
        self._service("start")
        if not self.health():
            raise Fail("The restored version isn't responding; check: journalctl -u certforge")
        now, nrev = self.installed()
        self._record(self.label(cur, rev), self.label(now, nrev), backup, "rollback")
        say(f"Done. CertForge {self.label(now, nrev)} is running.")
        say("The program was restored but not the data: if the newer version changed the database, the older one may not read it. The backup file holds the data from before the update.")
        return 0

    def _need_root(self) -> None:
        if not self.is_root():
            raise Fail("Run this as root: sudo certforge-update. Only an administrator of this machine can update CertForge.")


def read_line_all(path: Path) -> str:
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def trusted_env(path) -> dict:
    """The settings file is read as root and can name the repository the program is downloaded from, so
    it is only honoured if nobody but root (or whoever is running this) can have written it."""
    p = Path(path)
    try:
        st = p.stat()
    except OSError:
        return {}
    if st.st_uid not in (0, os.geteuid()) or st.st_mode & 0o022:
        say(f"Ignoring {p}: it must be owned by root and not writable by anyone else (chmod 600).")
        return {}
    if st.st_mode & 0o044:
        say(f"Note: {p} can be read by other users; if it holds a token run: chmod 600 {p}")
    return load_env_file(p)


def main(argv=None, env_file=ENV_FILE, **kw) -> int:
    ap = argparse.ArgumentParser(prog="certforge-update", description="Update CertForge in place (run as root on the host).")
    ap.add_argument("ref", nargs="?", help="a branch or tag to install from GitHub (an unreleased build), e.g. main")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--check", action="store_true", help="say what is available (or where REF is now); change nothing")
    g.add_argument("--rollback", action="store_true", help="return to the program saved by the last update")
    g.add_argument("--file", metavar="TARBALL", help="install a release tarball you already downloaded")
    ap.add_argument("--version", metavar="X.Y.Z", help="install this release instead of the newest")
    ap.add_argument("--release", action="store_true", help="install the newest release even if CERTFORGE_REF is set")
    ap.add_argument("--force", action="store_true", help="reinstall even if this commit is already installed")
    ap.add_argument("--sha256", help="expected SHA-256 of --file")
    ap.add_argument("--repo", default=None, help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    conf = trusted_env(env_file)
    repo = a.repo or os.environ.get("CERTFORGE_UPDATE_REPO") or conf.get("CERTFORGE_UPDATE_REPO") or REPO
    token = os.environ.get("GITHUB_TOKEN") or conf.get("GITHUB_TOKEN") or ""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}", repo):
        say("That isn't a GitHub repository name like owner/name.")
        return 2
    ref = a.ref
    if ref and (a.version or a.file or a.rollback):
        say("Give either a branch/tag or --version/--file/--rollback, not both.")
        return 2
    if not ref and not (a.version or a.file or a.rollback or a.release):
        ref = conf.get("CERTFORGE_REF") or None            # what a plain `certforge-update` installs on this machine
    if ref and not valid_ref(ref):
        say(f"'{ref}' isn't a usable branch or tag name.")
        return 2
    u = Updater(repo=repo, token=token, **kw)
    try:
        if a.check:
            return u.check(a.version, ref)
        if a.rollback:
            return u.rollback()
        return u.install(version=a.version, file=Path(a.file) if a.file else None, sha256=a.sha256, ref=ref, force=a.force)
    except Fail as e:
        say(f"certforge-update: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
